# Cache headers for Workers Static Assets.

# Next fingerprints everything under /_next/static, so it can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Every derivative carries a content hash in its filename, so a replaced
# photograph is a different URL and nothing here can ever go stale.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# The share cards and the manifest are the exception: they keep stable names.
/images/*-og.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/images/images.manifest.json
  Cache-Control: public, max-age=3600

# Build artifacts describing the catalogue. They change when the site is
# rebuilt, which the drip schedule makes a daily event.
/sitemap.xml
  Cache-Control: public, max-age=3600

/og-default.png
  Cache-Control: public, max-age=31536000, immutable
