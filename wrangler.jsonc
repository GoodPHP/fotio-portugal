{
	"$schema": "node_modules/wrangler/config-schema.json",
	// A new worker, beside the France one rather than replacing it: the two
	// sites are separate deployments on separate domains, and a rename here
	// would orphan the France worker's routes.
	//
	// `services[0].service` below is this worker calling itself, so the two
	// names have to stay identical. A mismatch is accepted by the build and
	// fails at deploy, which is the expensive place to find out.
	//
	// Secrets are not in this file. They live on the worker itself
	// (`wrangler secret list` to see which):
	//   npx wrangler secret put TELEGRAM_BOT_TOKEN
	//   npx wrangler secret put TELEGRAM_CHAT_ID
	"name": "fotio-portugal",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-01",
	// nodejs_compat: the Next.js server and the lead route need Node builtins.
	// global_fetch_strictly_public: makes fetch() inside the worker go out to the
	// public internet, which is what Next's own data fetching assumes.
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Both custom domains, declared here rather than only in the dashboard. A
	// deploy overwrites the remote configuration with this file, so a route that
	// lives only in the dashboard is one bad deploy away from being dropped.
	"routes": [
		{ "pattern": "fotio.pt", "zone_name": "fotio.pt", "custom_domain": true },
		{ "pattern": "www.fotio.pt", "zone_name": "fotio.pt", "custom_domain": true }
	],
	// No self-reference binding and no revalidation queue: every page is
	// prerendered and nothing revalidates, so the Durable Object that used to
	// carry the queue existed only to be warned about on every build.
	// next/image runs through Cloudflare's image service.
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	}

	// No "vars" block. NEXT_PUBLIC_* values are inlined by Next at build time
	// and live in .env; the ROLLOUT_* knobs are read at runtime and can be added
	// here when a value other than the default is wanted.
}
