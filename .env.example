# Copy to .env.local for development. Every value degrades gracefully when
# absent, so the site runs without any of them.

# Canonical origin, without a trailing slash. Drives canonical URLs, hreflang,
# the sitemap and every JSON-LD @id — so a wrong value here is wrong everywhere.
NEXT_PUBLIC_SITE_URL=https://www.fotio.pt

# WhatsApp business number, international format without "+". Portugal is 351.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Social profiles. Emitted as Organization.sameAs; omitted entirely when unset.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# GA4. Unset means no analytics script is loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Lead alerts. Without both, /api/lead answers 502 and the client falls back to
# WhatsApp, so a misconfigured bot never silently swallows an enquiry.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gradual rollout. Pages are released evenly across a window rather than all at
# once. Gating is on in production and off everywhere else unless forced.
#   ROLLOUT_ENABLED      'true' / 'false' to force; unset follows NODE_ENV
#   ROLLOUT_START        ISO date the drip begins (set this to the launch date)
#   ROLLOUT_WINDOW_DAYS  days over which everything releases
ROLLOUT_ENABLED=
ROLLOUT_START=
ROLLOUT_WINDOW_DAYS=

# Unsplash key for scripts/fetch-photos.py, which is run by hand, not by the build.
UNSPLASH_KEY=
